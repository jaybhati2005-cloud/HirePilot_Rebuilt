# Existing text-generation providers (resume, question generation, scoring)
GROQ_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER_ORDER=groq,gemini
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT=40
AI_RETRIES=1
AI_CONCURRENCY=6

# Live voice: LiveKit WebRTC + Deepgram STT/TTS + Groq LLM
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=aura-2-asteria-en
DEEPGRAM_EAGER_EOT_THRESHOLD=0.4
DEEPGRAM_MIP_OPTOUT=false
GROQ_VOICE_MODEL=openai/gpt-oss-20b

# Comma-separated frontend origins. Keep * for local development only.
CORS_ORIGINS=*
